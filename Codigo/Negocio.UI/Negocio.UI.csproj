<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Negocio.BLL\Negocio.BLL.csproj" />
    <ProjectReference Include="..\Services\Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="openrin.ico" />
  </ItemGroup>

  <!-- Ayuda en línea (D02): el .chm debe quedar junto al ejecutable, porque PrincipalForm
       lo busca en AppContext.BaseDirectory. Sin esto, el botón Ayuda y el F1 avisan que
       no encuentran el archivo. El instalador lo copia aparte al publicar. -->
  <ItemGroup>
    <None Include="..\..\Documentacion\Manuales\OpenRIN-Ayuda.chm"
          Link="OpenRIN-Ayuda.chm"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
  </ItemGroup>

  <!-- Formularios y controles con diseñador: Visual Studio los reconoce como tales y anida
       el archivo .Designer.cs debajo del .cs en el Explorador de soluciones, habilitando
       la vista de diseño (arrastrar y soltar controles desde el Cuadro de herramientas). -->
  <ItemGroup>
    <Compile Update="LoginForm.cs"><SubType>Form</SubType></Compile>
    <Compile Update="LoginForm.Designer.cs"><DependentUpon>LoginForm.cs</DependentUpon></Compile>
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>openrin.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Formularios y controles con diseniador: Visual Studio los reconoce como tales y anida
       el archivo .Designer.cs debajo del .cs en el Explorador de soluciones, habilitando
       la vista de disenio (arrastrar y soltar controles desde el Cuadro de herramientas). -->
